# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=kait2en-gdm-theme
pkgver=r3.b477249
pkgrel=1
pkgdesc="KaiT2en GDM login-screen theme"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('gdm')
makedepends=('git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
backup=('etc/dconf/db/gdm.d/00-kait2en')
install="$pkgname.install"
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _revision _commit _p="$srcdir/KaiT2en-Fedora/assets/gdm"
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf 'r%s.%s' "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/assets"
    mkdir -p "$srcdir/assets"
    cp -a "$srcdir/KaiT2en-Fedora/assets/." "$srcdir/assets/"
}

package() {
    install -D -m0644 "$srcdir/assets/gdm/00-kait2en" "$pkgdir/etc/dconf/db/gdm.d/00-kait2en"
    install -D -m0644 "$srcdir/assets/gdm/kait2en-gdm-logo.png" "$pkgdir/usr/share/pixmaps/kait2en-gdm-logo.png"
    install -D -m0644 "$srcdir/assets/gdm/gdm-black.png" "$pkgdir/usr/share/backgrounds/kait2en/gdm-black.png"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
