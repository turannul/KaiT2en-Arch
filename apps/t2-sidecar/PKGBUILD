# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=t2-sidecar
pkgver=0.1.0.r1.cb57109
pkgrel=1
pkgdesc="Virtual display sidecar for Apple T2 MacBooks"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject')
makedepends=('git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _revision _commit _p="$srcdir/KaiT2en-Fedora/apps/$pkgname"
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '0.1.0.r%s.%s' "${_revision:?}" "${_commit:?}"
}

package() {
    install -d -m0755 "$pkgdir/usr/bin" "$pkgdir/usr/libexec" "$pkgdir/usr/lib/systemd/user"
    install -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/t2-sidecar" "$pkgdir/usr/bin/t2-sidecar"
    install -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/t2-sidecar-display" "$pkgdir/usr/libexec/t2-sidecar-display"
    install -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/t2-sidecar.service" "$pkgdir/usr/lib/systemd/user/t2-sidecar.service"
    install -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/t2-sidecar-sunshine.service" "$pkgdir/usr/lib/systemd/user/t2-sidecar-sunshine.service"
    sed -i 's|/usr/local/bin|/usr/bin|g; s|/usr/local/libexec|/usr/libexec|g' \
        "$pkgdir/usr/lib/systemd/user/t2-sidecar.service" \
        "$pkgdir/usr/lib/systemd/user/t2-sidecar-sunshine.service"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}