_warn() {
    echo -e "\e[31mThis application may break functionality of your Mac. Use with caution!\e[0m"
}

post_install() {
    _warn
    rm -f /usr/lib/t2-power-tune/t2-power-tune-cstates /usr/local/libexec/t2-power-tune-cstates
}

post_upgrade() {
    post_install
}

post_remove() {
    systemctl disable --now kait2en-power-tune-resume.service kait2en-power-tune.service
    rm -f /etc/systemd/system/kait2en-power-tune-resume.service /etc/systemd/system/kait2en-power-tune.service /run/t2-power-tune/items.json
    systemctl daemon-reload
    echo -e "\e[33mPower-Tune is uninstalled - reboot when convenient.\e[0m"
}
