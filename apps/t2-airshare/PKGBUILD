# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=t2-airshare
pkgver=0
pkgrel=0
pkgdesc="Share files with Android phones over Quick Share and with Apple devices over AirDrop"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('bluez' 'gtk4' 'libadwaita' 'kait2en-assets' 't2-drop')
optdepends=(
    't2-drop: AirDrop extension for t2-airshare'
    'kait2en-wireless-runtime-pm: Patched WiFi/BT modules for stock Arch kernel (linux)'
    'kait2en-wireless-runtime-pm-t2: Patched WiFi/BT modules for T2 kernel (linux-t2)'
    'kait2en-wireless-runtime-pm-cachy: Patched WiFi/BT modules for CachyOS kernel (linux-cachyos)'
    'nautilus-python: Send entry for GNOME Files'
    'nemo: Send entry for Cinnamon'
)
makedepends=('cargo' 'git')
provides=('t2-share' "$pkgname-git")
conflicts=('t2-share' "$pkgname-git")
replaces=('t2-share' "$pkgname-git")
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora/apps/$pkgname"
  _version=$(awk -F'"' '/^\[package\]/{p=1} p && /^version *=/{print $2; exit}' "$_p/Cargo.toml")
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    cargo fetch --locked --manifest-path "$srcdir/KaiT2en-Fedora/apps/$pkgname/Cargo.toml"
    for _f in org.t2airshare.gtk.desktop systemd/t2-airshare.service integration/org.t2airshare.send.desktop \
        integration/t2-airshare-send.py integration/t2-airshare-send.nemo_action \
        integration/t2-airshare-send.servicemenu.desktop; do
        [ -f "$srcdir/KaiT2en-Fedora/apps/$pkgname/$_f" ] || continue
        sed -i 's|/usr/local/bin|/usr/bin|g' "$srcdir/KaiT2en-Fedora/apps/$pkgname/$_f"
    done
    sed -i 's|/usr/local/share/kait2en|/usr/share/kait2en|g' "$srcdir/KaiT2en-Fedora/apps/$pkgname/src/bin/t2-airshare/main.rs"
}

build() {
    make -C "$srcdir/KaiT2en-Fedora/apps/$pkgname" build
}

package() {
    install -D -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/target/release/t2-airshare" "$pkgdir/usr/bin/t2-airshare"
    install -D -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/target/release/t2airshare" "$pkgdir/usr/bin/t2airshare"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/org.t2airshare.gtk.desktop" "$pkgdir/usr/share/applications/org.t2airshare.gtk.desktop"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/integration/org.t2airshare.send.desktop" "$pkgdir/usr/share/applications/org.t2airshare.send.desktop"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/assets/icons/hicolor/scalable/apps/org.t2airshare.gtk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.t2airshare.gtk.svg"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/systemd/t2-airshare.service" "$pkgdir/usr/lib/systemd/user/t2-airshare.service"
    install -D -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/integration/t2-airshare-send.servicemenu.desktop" "$pkgdir/usr/share/kio/servicemenus/t2-airshare-send.desktop"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/integration/t2-airshare-send.nemo_action" "$pkgdir/usr/share/nemo/actions/t2-airshare-send.nemo_action"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/integration/t2-airshare-send.py" "$pkgdir/usr/share/nautilus-python/extensions/t2-airshare-send.py"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/THIRD-PARTY-NOTICES.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/proto/LICENSE-Apache-2.0" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Apache-2.0"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/proto/LICENSE-Chromium" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Chromium"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
