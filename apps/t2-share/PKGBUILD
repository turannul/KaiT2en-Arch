# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=t2-share
pkgver=0.1.0.r3.be7f136
pkgrel=3
pkgdesc="Send and receive files with Android Quick Share (Nearby Share)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'kait2en-assets')
optdepends=(
    'kait2en-wireless-runtime-pm: Patched WiFi/BT modules for stock Arch kernel (linux)'
    'kait2en-wireless-runtime-pm-t2: Patched WiFi/BT modules for T2 kernel (linux-t2)'
    'kait2en-wireless-runtime-pm-cachy: Patched WiFi/BT modules for CachyOS kernel (linux-cachyos)'
    'nautilus-python: Send entry for GNOME Files'
    'nemo: Send entry for Cinnamon'
)
makedepends=('cargo' 'git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
install="$pkgname.install"
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora/apps/$pkgname"
  _version=$(awk -F'"' '/^\[package\]/{p=1} p && /^version *=/{print $2; exit}' "$_p/Cargo.toml")
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    sed -i 's|:= \$(PREFIX)|:= $(DESTDIR)$(PREFIX)|g' "$srcdir/KaiT2en-Fedora/apps/$pkgname/Makefile"
    cargo fetch --locked --manifest-path "$srcdir/KaiT2en-Fedora/apps/$pkgname/Cargo.toml"
}

build() {
    make -C "$srcdir/KaiT2en-Fedora/apps/$pkgname" build
}

package() {
    make -C "$srcdir/KaiT2en-Fedora/apps/$pkgname" install DESTDIR="$pkgdir" PREFIX=/usr \
        GTK_UPDATE_ICON_CACHE=true UPDATE_DESKTOP_DATABASE=true
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
