# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=t2-drop
pkgver=0
pkgrel=0
pkgdesc="AirDrop to Apple devices over AWDL, the system service of T2 AirShare"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('bluez' 'dbus' 'systemd')
optdepends=(
    'kait2en-wireless-runtime-pm: Patched brcmfmac with AWDL for stock Arch kernel (linux)'
    'kait2en-wireless-runtime-pm-t2: Patched brcmfmac with AWDL for T2 kernel (linux-t2)'
    'kait2en-wireless-runtime-pm-cachy: Patched brcmfmac with AWDL for CachyOS kernel (linux-cachyos)'
)
makedepends=('cargo' 'git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')
options=('!lto')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora/apps/$pkgname"
  _version=$(awk -F'"' '/^\[package\]/{p=1} p && /^version *=/{print $2; exit}' "$_p/Cargo.toml")
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    cargo fetch --locked --manifest-path "$srcdir/KaiT2en-Fedora/apps/$pkgname/Cargo.toml"
    sed -i 's|/usr/local/bin|/usr/bin|g' "$srcdir/KaiT2en-Fedora/apps/$pkgname/systemd/t2-drop.service"
}

build() {
    make -C "$srcdir/KaiT2en-Fedora/apps/$pkgname" build
}

package() {
    install -D -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/target/release/t2drop" "$pkgdir/usr/bin/t2drop"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/systemd/t2-drop.service" "$pkgdir/usr/lib/systemd/system/t2-drop.service"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/dbus/org.t2drop.conf" "$pkgdir/usr/share/dbus-1/system.d/org.t2drop.conf"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/dbus/org.t2drop.service" "$pkgdir/usr/share/dbus-1/system-services/org.t2drop.service"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
