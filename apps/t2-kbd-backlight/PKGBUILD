# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=t2-kbd-backlight
pkgver=0.1.0.r1.fb187c0
pkgrel=1
pkgdesc="Keyboard backlight idle timeout for Apple T2 MacBooks"
arch=('x86_64')
url="https://kait2en.org/documentation.html#t2-keyboard-backlight"
license=('GPL-3.0-or-later')
depends=('upower')
makedepends=('cargo' 'git' 'libinput')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
backup=('etc/kait2en/kbd-backlight.toml')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora/apps/$pkgname"
  _version=$(awk -F'"' '/^\[package\]/{p=1} p && /^version *=/{print $2; exit}' "$_p/Cargo.toml")
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    cargo fetch --locked --manifest-path "$srcdir/KaiT2en-Fedora/apps/$pkgname/Cargo.toml"
}

build() {
    make -C "$srcdir/KaiT2en-Fedora/apps/$pkgname" build
}

package() {
    install -d -m0755 "$pkgdir/usr/bin" "$pkgdir/usr/lib/systemd/system" "$pkgdir/etc/kait2en"
    install -m0755 "$srcdir/KaiT2en-Fedora/apps/$pkgname/target/release/t2-kbd-backlight" "$pkgdir/usr/bin/t2-kbd-backlight"
    install -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/systemd/t2-kbd-backlight.service" "$pkgdir/usr/lib/systemd/system/t2-kbd-backlight.service"
    [ -e "$pkgdir/etc/kait2en/kbd-backlight.toml" ] || install -m0644 "$srcdir/KaiT2en-Fedora/apps/$pkgname/config/kbd-backlight.toml" "$pkgdir/etc/kait2en/kbd-backlight.toml"
    sed -i 's|/usr/local/bin|/usr/bin|g' "$pkgdir/usr/lib/systemd/system/t2-kbd-backlight.service"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
