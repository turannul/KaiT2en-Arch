# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=hid_t2magicmouse-dkms
pkgver=0.1.r5.ce07b03
pkgrel=1
pkgdesc="KaiT2en Apple HID module"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=(
    'linux-t2-headers: build modules against the T2 kernel'
    'linux-headers: build modules against the Arch kernel'
)
makedepends=('git')
provides=('hid_t2magicmouse')
conflicts=('hid_t2magicmouse')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora/modules/${pkgname%-dkms}"
  _version=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_p/dkms.conf")
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/hid_t2magicmouse"
    mkdir -p "$srcdir/hid_t2magicmouse"
    cp -a "$srcdir/KaiT2en-Fedora/modules/hid_t2magicmouse/." "$srcdir/hid_t2magicmouse/"
}

package() {
    _module_version=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$srcdir/KaiT2en-Fedora/modules/${pkgname%-dkms}/dkms.conf")
    install -d -m0755 "$pkgdir/usr/src/hid_t2magicmouse-$_module_version"
    cp -a "$srcdir/hid_t2magicmouse/." "$pkgdir/usr/src/hid_t2magicmouse-$_module_version/"
    sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$_module_version\"/" "$pkgdir/usr/src/hid_t2magicmouse-$_module_version/dkms.conf"
    install -D -m0644 "$startdir/modprobe.d/00-kait2en-hid-t2magicmouse.conf" "$pkgdir/usr/lib/modprobe.d/00-kait2en-hid-t2magicmouse.conf"
    install -D -m0644 "$startdir/mkinitcpio.conf.d/00-kait2en-hid-t2magicmouse.conf" "$pkgdir/etc/mkinitcpio.conf.d/00-kait2en-hid-t2magicmouse.conf"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
