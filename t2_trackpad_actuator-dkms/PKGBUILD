# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=t2_trackpad_actuator-dkms
pkgver=0.01.r612.g431d05b
pkgrel=1
pkgdesc="KaiT2en trackpad actuator module"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=(
    'linux-t2-headers: build modules against the T2 kernel'
    'linux-headers: build modules against the Arch kernel'
)
makedepends=('git')
provides=('t2_trackpad_actuator')
conflicts=('t2_trackpad_actuator')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora/modules/${pkgname%-dkms}"
  _version=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_p/dkms.conf")
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/t2_trackpad_actuator"
    mkdir -p "$srcdir/t2_trackpad_actuator"
    cp -a "$srcdir/KaiT2en-Fedora/modules/t2_trackpad_actuator/." "$srcdir/t2_trackpad_actuator/"
}

package() {
    install -d -m0755 "$pkgdir/usr/src/t2_trackpad_actuator-$pkgver"
    cp -a "$srcdir/t2_trackpad_actuator/." "$pkgdir/usr/src/t2_trackpad_actuator-$pkgver/"
    sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" "$pkgdir/usr/src/t2_trackpad_actuator-$pkgver/dkms.conf"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
