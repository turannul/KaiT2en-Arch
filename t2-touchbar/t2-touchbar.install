_detect_user() {
    [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ] && user="$SUDO_USER" && return
    user=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" && $3 != "root" && $3 != "" {print $3; exit}')
    [ -n "$user" ] && return
    user=$(logname 2>/dev/null)
    [ -n "$user" ] && [ "$user" != "root" ] && return
    user=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65000 && $7 !~ /(nologin|false)$/ {print $1; exit}')
}

post_install() {
    systemctl enable kait2en-touchbar-attach.service

    _detect_user
    if [ -n "$user" ]; then
        local uid runtime
        uid=$(id -u "$user")
        runtime="/run/user/$uid"
        if [ -d "$runtime" ]; then
            runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" systemctl --user enable kait2en-touchbar.service ||
                echo "==> [kait2en] could not pre-enable the bar UI; enable it with: systemctl --user enable --now kait2en-touchbar"
        else
            echo "==> [kait2en] user runtime $runtime is not active; enable the bar UI after login with: systemctl --user enable --now kait2en-touchbar"
        fi
    else
        echo "==> [kait2en] no user detected; enable the bar UI with: systemctl --user enable --now kait2en-touchbar"
    fi

    [ -d /run/udev ] && udevadm control --reload-rules && udevadm trigger -s drm -s backlight -s input -s usb || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    [ -d /run/systemd/system ] && systemctl disable --now kait2en-touchbar-attach.service || true

    _detect_user
    if [ -n "$user" ]; then
        local uid runtime
        uid=$(id -u "$user")
        runtime="/run/user/$uid"
        [ -d "$runtime" ] && runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" systemctl --user disable kait2en-touchbar.service || true
    fi
}
