# Packager: Turann_ <turanull000@gmail.com>

pkgname=kait2en-assets
pkgver=r8.d6ce476
pkgrel=3
pkgdesc="Shared branding assets and fonts"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
makedepends=('git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/assets"
    printf "r%s.%s" "$(git -C "$src" rev-list --count HEAD -- .)" "$(git -C "$src" log -1 --format="%h" -- .)"
}

package() {
    local src="$srcdir/KaiT2en-Fedora/assets"
    install -d -m0755 "$pkgdir/usr/share/kait2en"
    install -m0644 "$src/kait2en-app-logo.png" "$pkgdir/usr/share/kait2en/kait2en-wordmark.png"
    if [[ -f "$src/kaiT2en-logo.png" ]]; then
        install -m0644 "$src/kaiT2en-logo.png" "$pkgdir/usr/share/kait2en/kaiT2en-logo.png"
    fi
    if [[ -d "$src/fonts" ]]; then
        install -d -m0755 "$pkgdir/usr/share/fonts/kait2en"
        install -m0644 "$src/fonts"/*.ttf "$pkgdir/usr/share/fonts/kait2en/"
    fi
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
