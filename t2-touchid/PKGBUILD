# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2-touchid
pkgver=0.1.0.r11.afb6fde
pkgrel=3
pkgdesc="Touch ID bridge daemon for fprintd"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'fprintd' 'libfprint' 't2-services')
optdepends=('react-drm')
makedepends=('cargo' 'git' 'make')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
backup=('etc/kait2en/t2-touchid.conf')
install="$pkgname.install"
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-touchid"
    local ver=$(sed -n 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src/Cargo.toml" | head -n1)
    printf "%s.r%s.%s" "${ver:-0.1.0}" "$(git -C "$srcdir/KaiT2en-Fedora" rev-list --count HEAD -- apps/t2-touchid t2-services/t2-touchid)" "$(git -C "$srcdir/KaiT2en-Fedora" log -1 --format="%h" -- apps/t2-touchid t2-services/t2-touchid)"
}

build() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-touchid"
    cd "$src"
    cargo build --release
}

package() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-touchid"
    make -C "$src" install PREFIX=/usr DESTDIR="$pkgdir" TARGET_DIR="$src/target"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
