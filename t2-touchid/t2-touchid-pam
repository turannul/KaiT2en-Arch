#!/bin/sh
set -u
pkg="t2-touchid"
targets="sudo doas polkit-1 swaylock hyprlock waylock gtklock i3lock"
b="#############################################################"
cnt="$b
# Managed by $pkg - DO NOT EDIT
auth        sufficient  pam_fprintd.so timeout=60 max-tries=3
$b"

enable_one() {
    f="/etc/pam.d/$1"
    if [ ! -f "$f" ]; then
        return 0
    fi
    if grep -q "pam_fprintd\.so" "$f"; then
        echo "==> [kait2en] Touch ID already enabled for $1"
        return 0
    fi
    awk -v b="$cnt" '!done && /^[[:space:]]*auth[[:space:]]/ {print b; done=1} {print} END {if (!done) print b}' "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
    echo "==> [kait2en] Enabled Touch ID for $1"
}

disable_one() {
    f="/etc/pam.d/$1"
    [ -f "$f" ] || return 0
    if grep -q "[Mm]anaged by $pkg" "$f"; then
        awk -v pkg="$pkg" -v b="$b" '
            /^#{8,}/ { if (in_b) { in_b=0; next }; if (p_b) print b; p_b=1; next }
            p_b { if ($0 ~ "^# [Mm]anaged by " pkg) { in_b=1; p_b=0; next } print b; p_b=0 }
            in_b {
                if (!($0 ~ /pam_fprintd\.so/)) { in_b=0; print; next }
                next
            }
            { print }
            END { if (p_b) print b }
        ' "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
        echo "==> [kait2en] Disabled Touch ID for $1"
    else
        echo "==> [kait2en] No managed Touch ID found for $1"
    fi
}

act="enable"
if [ "$#" -gt 0 ]; then
    case "$1" in
        enable|disable) act="$1"; shift ;;
        *) echo "==> [kait2en] Unexpected/unknown action: '$1'" >&2; exit 1 ;;
    esac
fi
if [ "$#" -eq 0 ]; then
    set -- $targets
fi
case "$act" in
    enable) for t in "$@"; do enable_one "$t"; done ;;
    disable) for t in "$@"; do disable_one "$t"; done ;;
esac
