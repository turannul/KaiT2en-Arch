_detect_user() {
    [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ] && user="$SUDO_USER" && return
    user=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" && $3 != "root" && $3 != "" {print $3; exit}')
    [ -n "$user" ] && return
    user=$(logname 2>/dev/null)
    [ -n "$user" ] && [ "$user" != "root" ] && return
    user=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65000 && $7 !~ /(nologin|false)$/ {print $1; exit}')
}

_bind_user() {
    local etc_conf="/etc/kait2en/t2-touchid.conf"

    _detect_user
    [ -z "$user" ] && echo "==> [kait2en] No user detected; set T2_TOUCHID_BIND_USER in $etc_conf" && return 0

    if [ ! -f "$etc_conf" ]; then
        install -d -m 0755 /etc/kait2en
        printf 'T2_TOUCHID_UID=auto\nT2_TOUCHID_FLAGS=0\nT2_TOUCHID_BIND_USER=%s\nT2_TOUCHID_SOCKET=/run/t2-touchid/fprint.sock\n' "$user" > "$etc_conf"
        echo "==> [kait2en] Bound Touch ID to user '$user' in $etc_conf"
    elif grep -q '^T2_TOUCHID_BIND_USER=none' "$etc_conf"; then
        sed -i "s/^T2_TOUCHID_BIND_USER=none/T2_TOUCHID_BIND_USER=$user/" "$etc_conf"
        echo "==> [kait2en] Bound Touch ID to user '$user' in $etc_conf"
    elif ! grep -q '^T2_TOUCHID_BIND_USER=' "$etc_conf"; then
        echo "T2_TOUCHID_BIND_USER=$user" >> "$etc_conf"
        echo "==> [kait2en] Bound Touch ID to user '$user' in $etc_conf"
    fi
}

# WARNING: Hey read this before changing this, are you so smart i couldn't think what you have done?
# WARNING: I will avoid modifying system-*-login it (may) does break login/display managers and/or keyrings.
# INFO: KDE & GNOME Screen lock do not require manual configuration.
# INFO: According to my search, services that require manual configuration are down below.
_PAM_TARGETS="sudo doas polkit-1 swaylock hyprlock waylock gtklock i3lock"
# INFO: If i missed any, please let me know, or add here ^ and PR please?.

_pam_handler() {
    local act="$1" t="$2"
    local f="/etc/pam.d/$t" pkg="t2-touchid"
    local b="#############################################################"
    local cnt="$b
# Managed by $pkg - DO NOT EDIT
auth        sufficient  pam_fprintd.so timeout=60 max-tries=3
$b"
# INFO: I believe 60s and 3 max-tries are reasonable defaults.

    [[ ! -f "$f" ]] && {
        echo "==> [kait2en] Skipping $t (not installed)"
        return 0
    }

    case "$act" in
        enable)
            if grep -q "pam_fprintd\.so" "$f"; then
                echo "==> [kait2en] Touch ID already enabled for $t"
                return 0
            fi
            awk -v b="$cnt" '!done && /^[[:space:]]*auth[[:space:]]/ {print b; done=1} {print} END {if (!done) print b}' "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
            echo "==> [kait2en] Enabled Touch ID for $t"
            ;;
        disable)
            if grep -q "[Mm]anaged by $pkg" "$f"; then
                awk -v pkg="$pkg" -v b="$b" '
                    /^#{8,}/ { if (in_b) { in_b=0; next }; if (p_b) print b; p_b=1; next }
                    p_b { if ($0 ~ "^# [Mm]anaged by " pkg) { in_b=1; p_b=0; next } print b; p_b=0 }
                    in_b {
                        if (!($0 ~ /pam_fprintd\.so/)) { in_b=0; print; next }
                        next
                    }
                    { print }
                    END { if (p_b) print b }
                ' "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
                echo "==> [kait2en] Disabled Touch ID for $t"
            else
                echo "==> [kait2en] No managed Touch ID found for $t"
            fi
            ;;
        *)
            echo "==> [kait2en] Unexpected/unknown action: '$act'" >&2
            return 1
            ;;
    esac
}

post_install() {
    _bind_user
    systemctl enable kait2en-t2-touchid.service
    [ -d /run/systemd/system ] && systemctl daemon-reload
    [ -d /run/systemd/system ] && systemctl restart kait2en-t2-touchid.service fprintd.service
    for t in $_PAM_TARGETS; do _pam_handler enable "$t"; done
}

post_upgrade() {
    _bind_user
    [ -d /run/systemd/system ] && systemctl daemon-reload
    [ -d /run/systemd/system ] && systemctl try-restart kait2en-t2-touchid.service fprintd.service
    for t in $_PAM_TARGETS; do _pam_handler enable "$t"; done
}

pre_remove() {
    [ -d /run/systemd/system ] && systemctl stop kait2en-t2-touchid.service
    [ -d /run/systemd/system ] && systemctl daemon-reload
    [ -d /run/systemd/system ] && systemctl try-restart fprintd.service
    systemctl disable kait2en-t2-touchid.service
    for t in $_PAM_TARGETS; do _pam_handler disable "$t"; done
}
