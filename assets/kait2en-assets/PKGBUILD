# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=kait2en-assets
pkgver=r15.c42f21e
pkgrel=1
pkgdesc="Shared branding assets and fonts"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
makedepends=('git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _revision _commit _p="$srcdir/KaiT2en-Fedora/assets"
  _revision=$(git -C "$_p" rev-list --count HEAD -- .)
  _commit=$(git -C "$_p" log -1 --format="%h" -- .)
  printf 'r%s.%s' "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/assets"
    mkdir -p "$srcdir/assets"
    cp -a "$srcdir/KaiT2en-Fedora/assets/." "$srcdir/assets/"
}

package() {
    install -d -m0755 "$pkgdir/usr/share/kait2en"
    install -m0644 "$srcdir/assets/kait2en-app-logo.png" "$pkgdir/usr/share/kait2en/kait2en-wordmark.png"
    for f in kaiT2en-logo.png kaiT2en-logo-tr.png kaiT2en-logo-tr.svg kait2en-fedora.jpeg kanji.ans kanji.txt; do
        [[ -f "$srcdir/assets/$f" ]] && install -m0644 "$srcdir/assets/$f" "$pkgdir/usr/share/kait2en/$f"
    done
    install -d -m0755 "$pkgdir/usr/share/fonts/kait2en"
    install -m0644 "$srcdir/assets/fonts"/*.ttf "$pkgdir/usr/share/fonts/kait2en/"
    install -D -m0644 "$srcdir/assets/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
