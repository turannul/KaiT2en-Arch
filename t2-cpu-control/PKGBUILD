# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2-cpu-control
pkgver=0.02.r13.c23ede9
pkgrel=3
pkgdesc="CPU power limit and thermal telemetry controller"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit' 'msr-tools' 'kait2en-assets')
optdepends=('linux-headers' 't2smc-dkms')
makedepends=('git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
install="$pkgname.install"
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-cpu-control"
    local ver=$(sed -n 's/^[[:space:]]*APP_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src/t2-cpu-control.py" | head -n1)
    printf "%s.r%s.%s" "${ver:-0.02}" "$(git -C "$src" rev-list --count HEAD -- .)" "$(git -C "$src" log -1 --format="%h" -- .)"
}

prepare() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-cpu-control"
    sed -i 's|/usr/local/libexec|/usr/lib/t2-cpu-control|g' \
        "$src/t2-cpu-control.py" \
        "$src/t2-cpu-control.service" \
        "$src/t2-cpu-control-resume" \
        "$src/org.t2cpucontrol.policy"
    sed -i 's|/usr/local/share/kait2en|/usr/share/kait2en|g' "$src/t2-cpu-control.py"
    sed -i 's|/usr/local/bin|/usr/bin|g' "$src/org.t2cpucontrol.gtk.desktop"
}

package() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-cpu-control"

    install -d -m0755 \
        "$pkgdir/usr/bin" \
        "$pkgdir/usr/lib/t2-cpu-control" \
        "$pkgdir/usr/share/polkit-1/actions" \
        "$pkgdir/usr/share/applications" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps" \
        "$pkgdir/usr/lib/systemd/system" \
        "$pkgdir/usr/lib/systemd/system-sleep"

    install -m0755 "$src/t2-cpu-control.py" "$pkgdir/usr/bin/t2-cpu-control"

    install -m0755 "$src/t2-cpu-control-helper" "$pkgdir/usr/lib/t2-cpu-control/t2-cpu-control-helper"
    install -m0755 "$src/t2-cpu-control-status" "$pkgdir/usr/lib/t2-cpu-control/t2-cpu-control-status"
    install -m0755 "$src/t2-cpu-kernel-benchmark" "$pkgdir/usr/lib/t2-cpu-control/t2-cpu-kernel-benchmark"

    install -m0755 "$src/t2-cpu-control-resume" "$pkgdir/usr/lib/systemd/system-sleep/t2-cpu-control"
    install -m0644 "$src/t2-cpu-control.service" "$pkgdir/usr/lib/systemd/system/t2-cpu-control.service"

    install -m0644 "$src/org.t2cpucontrol.policy" "$pkgdir/usr/share/polkit-1/actions/org.t2cpucontrol.policy"
    install -m0644 "$src/org.t2cpucontrol.gtk.desktop" "$pkgdir/usr/share/applications/org.t2cpucontrol.gtk.desktop"
    install -m0644 "$src/org.t2cpucontrol.gtk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.t2cpucontrol.gtk.svg"

    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
