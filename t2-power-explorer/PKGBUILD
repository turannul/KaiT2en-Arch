# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2-power-explorer
pkgver=0.1.0.r9.1e444a6
pkgrel=3
pkgdesc="Device topology and runtime power state explorer"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'glib2' 'gcc-libs' 'polkit' 'kait2en-assets')
optdepends=('t2smc-dkms' 't2bce-dkms')
makedepends=('cargo' 'git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-power-explorer"
    local ver=$(sed -n 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src/Cargo.toml" | head -n1)
    printf "%s.r%s.%s" "${ver:-0.1.0}" "$(git -C "$src" rev-list --count HEAD -- .)" "$(git -C "$src" log -1 --format="%h" -- .)"
}

prepare() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-power-explorer"
    sed -i 's|/usr/local/share/kait2en|/usr/share/kait2en|g' "$src/src/ui.rs"
    sed -i 's|/usr/local/libexec|/usr/lib/t2-power-explorer|g' "$src/src/diagnostics.rs" "$src/org.t2powerexplorer.policy"
}

build() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-power-explorer"
    cd "$src"
    cargo build --release
}

package() {
    local src="$srcdir/KaiT2en-Fedora/apps/t2-power-explorer"

    install -d -m0755 "$pkgdir/usr/bin" "$pkgdir/usr/lib/t2-power-explorer" "$pkgdir/usr/share/polkit-1/actions" "$pkgdir/usr/share/applications" "$pkgdir/usr/share/icons/hicolor/scalable/apps"

    install -m0755 "$src/target/release/t2-power-explorer" "$pkgdir/usr/bin/t2-power-explorer"
    install -m0755 "$src/t2-power-explorer-status" "$pkgdir/usr/lib/t2-power-explorer/t2-power-explorer-status"

    install -m0644 "$src/org.t2powerexplorer.policy" "$pkgdir/usr/share/polkit-1/actions/org.t2powerexplorer.policy"
    install -m0644 "$src/org.t2powerexplorer.gtk.desktop" "$pkgdir/usr/share/applications/org.t2powerexplorer.gtk.desktop"
    install -m0644 "$src/assets/icons/hicolor/scalable/apps/org.t2powerexplorer.gtk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.t2powerexplorer.gtk.svg"

    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
