# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2bce-dkms
pkgver=0.01.r34.af6c17d
pkgrel=2
pkgdesc="KaiT2en BCE (dma, core, vhci, audio, ave) module"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=('linux' 'linux-headers')
makedepends=('git')
provides=('t2bce' 't2bce_core' 't2bce_audio' 't2bce_ave' 't2bce_dma' 't2bce_vhci')
conflicts=('linux-t2' 't2bce_core-dkms' 't2bce_audio-dkms' 't2bce_ave-dkms' 't2bce_dma-dkms' 't2bce_vhci-dkms')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora"
    local stack="$src/modules/t2bce_stack"
    local ver=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$stack/dkms.conf")
    local paths=(modules/t2bce_stack modules/t2bce_core modules/t2bce_dma modules/t2bce_audio modules/t2bce_ave modules/t2bce_vhci t2-services/t2-ave/kernel/t2bce_ave)
    printf "%s.r%s.%s" "${ver:-0.01}" "$(git -C "$src" rev-list --count HEAD -- "${paths[@]}")" "$(git -C "$src" log -1 --format="%h" -- "${paths[@]}")"
}

package() {
    local src="$srcdir/KaiT2en-Fedora"
    local dest="$pkgdir/usr/src/t2bce_stack-$pkgver"
    install -d -m0755 "$dest"
    cp -a "$src/modules/t2bce_stack/Makefile" "$src/modules/t2bce_stack/dkms.conf" "$src/modules/t2bce_stack/README.md" "$dest/"
    local m
    for m in t2bce_dma t2bce_core t2bce_vhci t2bce_audio; do
        cp -a "$src/modules/$m" "$dest/"
    done
    if [[ -d "$src/t2-services/t2-ave/kernel/t2bce_ave" ]]; then
        cp -a "$src/t2-services/t2-ave/kernel/t2bce_ave" "$dest/t2bce_ave"
    else
        cp -a "$src/modules/t2bce_ave" "$dest/t2bce_ave"
    fi
    find "$dest" -type f \( -name '*.o' -o -name '*.ko' -o -name '*.ko.zst' -o -name '*.mod' -o -name '*.mod.c' -o -name '*.mod.o' -o -name '.*.cmd' -o -name 'Module.symvers' -o -name 'modules.order' \) -delete
    sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" "$dest/dkms.conf"
    install -D -m0644 "$startdir/modprobe.d/00-kait2en-t2bce.conf" "$pkgdir/usr/lib/modprobe.d/00-kait2en-t2bce.conf"
    install -D -m0644 "$startdir/mkinitcpio.conf.d/00-kait2en-t2bce.conf" "$pkgdir/etc/mkinitcpio.conf.d/00-kait2en-t2bce.conf"
    install -D -m0644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
