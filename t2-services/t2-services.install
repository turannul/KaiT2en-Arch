post_install() {
    systemctl enable t2-services-suspend.service
    [ -d /run/systemd/system ] && systemctl try-reload-or-restart NetworkManager.service
}

post_upgrade() {
    post_install
}

pre_remove() {
    [ -d /run/systemd/system ] && systemctl stop t2-services-suspend.service
    systemctl disable t2-services-suspend.service
}