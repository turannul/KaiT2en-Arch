pkgname=bankstown
pkgver=1.1.0
pkgrel=1
pkgdesc='Bankstown LV2 Plugin'
arch=('x86_64')
url='https://github.com/chadmed/bankstown'
license=('MIT')
depends=('lv2')
makedepends=('cargo' 'git')
source=("git+https://github.com/chadmed/bankstown.git")
sha256sums=('SKIP')

pkgver() {
  git -C "$srcdir/bankstown" describe --tags --abbrev=0 | sed 's/^v//'
}

prepare() {
    git -C "$srcdir/bankstown" checkout "$pkgver"
    cargo fetch --locked --manifest-path "$srcdir/bankstown/Cargo.toml"
}

build() {
    make -C "$srcdir/bankstown"
}

package() {
    make -C "$srcdir/bankstown" DESTDIR="$pkgdir" LIBDIR=/usr/lib install
}
