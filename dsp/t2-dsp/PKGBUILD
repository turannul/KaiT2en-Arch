pkgname=t2-dsp
pkgver=r15.6ddacd9
pkgrel=1
pkgdesc="Model-specific host-side audio DSP"
arch=('any')
url="https://kait2en.org/documentation.html#audio-dsp"
license=('GPL-3.0-or-later')
groups=('kait2en-audio')
depends=('apple-t2-bridge-dkms' 'apple-t2-alsa-ucm-conf' 'pipewire' 'pipewire-audio' 'pipewire-pulse' 'wireplumber>=0.5.8' 'lsp-plugins-lv2' 'python' 'bankstown')
makedepends=('git' 'python' 'make')
provides=("$pkgname-git")
conflicts=("$pkgname-git" 't2bce_audio-dsp')
replaces=("$pkgname-git" 't2bce_audio-dsp')
install="$pkgname.install"
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _revision _commit _p="$srcdir/KaiT2en-Fedora"
  _revision=$(git -C "$_p" rev-list --count HEAD -- dsp)
  _commit=$(git -C "$_p" log -1 --format="%h" -- dsp)
  printf 'r%s.%s' "${_revision:?}" "${_commit:?}"
}

build() {
    make -C "$srcdir/KaiT2en-Fedora/dsp" build
}

check() {
    make -C "$srcdir/KaiT2en-Fedora/dsp" test
}

package() {
    make -C "$srcdir/KaiT2en-Fedora/dsp" install PREFIX=/usr LIBEXECDIR=/usr/lib DESTDIR="$pkgdir"
}
