# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2-ave
pkgver=0.1.0.r4.afb6fde
pkgrel=3
pkgdesc="T2 AVE encoder"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('t2-services' 'kmod')
makedepends=('cargo' 'git')
provides=("$pkgname-git")
conflicts=("$pkgname-git")
replaces=("$pkgname-git")
install="$pkgname.install"
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
[[ -d ../KaiT2en-Fedora/.git ]] && git -C ../KaiT2en-Fedora pull --ff-only && source=("KaiT2en-Fedora::git+file://$(realpath ../KaiT2en-Fedora)")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-ave"
    local ver=$(sed -n 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src/Cargo.toml" | head -n1)
    printf "%s.r%s.%s" "${ver:-0.1.0}" "$(git -C "$srcdir/KaiT2en-Fedora" rev-list --count HEAD -- t2-services/t2-ave)" "$(git -C "$srcdir/KaiT2en-Fedora" log -1 --format="%h" -- t2-services/t2-ave)"
}

build() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-ave"
    cd "$src"
    cargo build --release --locked
}

check() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-ave"
    cd "$src"
    cargo test --locked
}

package() {
    local src="$srcdir/KaiT2en-Fedora/t2-services/t2-ave"
    make -C "$src" install PREFIX=/usr LIBEXECDIR=/usr/lib DESTDIR="$pkgdir" TARGET_DIR="$src/target"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
