# Packager: Turann_ <turanull000@gmail.com>

pkgname=t2bdrm-dkms
pkgver=0.1.r6.47e8cd4
pkgrel=2
pkgdesc="KaiT2en TB-DRM module"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=('linux' 'linux-headers')
makedepends=('git')
provides=('t2bdrm')
conflicts=('linux-t2' 't2bdrm')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
    local src="$srcdir/KaiT2en-Fedora/modules/t2bdrm"
    local ver=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src/dkms.conf")
    printf "%s.r%s.%s" "${ver:-0.1}" "$(git -C "$src" rev-list --count HEAD -- .)" "$(git -C "$src" log -1 --format="%h" -- .)"
}

package() {
    local src="$srcdir/KaiT2en-Fedora/modules/t2bdrm"
    local dest="$pkgdir/usr/src/t2bdrm-$pkgver"
    install -d -m0755 "$dest"
    cp -a "$src/." "$dest/"
    find "$dest" -type f \( -name '*.o' -o -name '*.ko' -o -name '*.ko.zst' -o -name '*.mod' -o -name '*.mod.c' -o -name '*.mod.o' -o -name '.*.cmd' -o -name 'Module.symvers' -o -name 'modules.order' \) -delete
    sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" "$dest/dkms.conf"
    install -D -m0644 "$startdir/modprobe.d/00-kait2en-t2bdrm.conf" "$pkgdir/usr/lib/modprobe.d/00-kait2en-t2bdrm.conf"
    install -D -m0644 "$startdir/mkinitcpio.conf.d/00-kait2en-t2bdrm.conf" "$pkgdir/etc/mkinitcpio.conf.d/00-kait2en-t2bdrm.conf"
    install -D -m0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
