pre_upgrade() {
    local f
    for f in /etc/wireplumber/wireplumber.conf.d/51-kait2en-t2-dsp.conf /etc/pipewire/pipewire.conf.d/50-kait2en-quantum.conf; do
        if [[ -e "$f" ]] && ! pacman -Qqo "$f" >/dev/null 2>&1; then
            rm -f "$f"
        fi
    done
}

post_install() {
    local _user="${SUDO_USER:-}" _rt
    [[ -x /usr/lib/t2-dsp/package-actions ]] && bash /usr/lib/t2-dsp/package-actions configure
    if [[ -n "$_user" && "$_user" != root ]]; then
        _rt="/run/user/$(id -u "$_user" 2>/dev/null)"
        if [[ -d "$_rt" ]]; then
            runuser -u "$_user" -- env XDG_RUNTIME_DIR="$_rt" wpctl clear-default 0 || echo "==> [t2-dsp] run 'wpctl clear-default 0' after login to select the T2 output"
        else
            echo "==> [t2-dsp] run 'wpctl clear-default 0' after login to select the T2 output"
        fi
    fi
    [ -d /run/udev ] && udevadm control --reload-rules
    [ -d /run/udev ] && udevadm trigger -s sound || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    [[ -x /usr/lib/t2-dsp/package-actions ]] && bash /usr/lib/t2-dsp/package-actions removed
}
