# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

pkgname=apple-t2-bridge-dkms
pkgver=0.1.r8.6ddacd9
pkgrel=1
pkgdesc="Apple T2 bridge stack (bridge core, USB VHCI, audio, AVE, Sidecar)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=(
    'linux-cachyos-headers: build modules against the Cachy kernel'
    'linux-headers: build modules against the Arch kernel'
    'linux-t2-headers: build modules against the T2 kernel'
    'apple-t2-alsa-ucm-conf: ALSA UCM audio profiles'
    't2-dsp: Model-specific host-side audio DSP'
)
makedepends=('git')
conflicts=('t2bce' 't2bce_core' 't2bce_audio' 't2bce_ave' 't2bce_dma' 't2bce_vhci' 't2bce_sidecar' 't2bce-dkms')
replaces=('t2bce-dkms' 't2bce' 't2bce_core' 't2bce_audio' 't2bce_ave' 't2bce_dma' 't2bce_vhci' 't2bce_sidecar')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
sha256sums=('SKIP')

pkgver() {
  local _version _revision _commit _p="$srcdir/KaiT2en-Fedora" _paths=(modules/apple-t2-bridge t2-services/t2-ave/kernel)
  _version=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_p/modules/apple-t2-bridge/dkms.conf")
  _revision=$(git -C "$_p" rev-list --count HEAD -- "${_paths[@]}")
  _commit=$(git -C "$_p" log -1 --format="%h" -- "${_paths[@]}")
  printf '%s.r%s.%s' "${_version:?}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    local src="$srcdir/KaiT2en-Fedora" dest="$srcdir/apple-t2-bridge"
    rm -rf "$dest"
    mkdir -p "$dest"
    cp -a "$src/modules/apple-t2-bridge/." "$dest/"
    for c in t2-ave t2-sidecar; do
        cp -a "$src/t2-services/t2-ave/kernel/$c" "$dest/$c"
    done
}

package() {
    local src="$srcdir/KaiT2en-Fedora"
    local dest="$srcdir/apple-t2-bridge"
    _module_version=$(sed -n 's/^[[:space:]]*PACKAGE_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$dest/dkms.conf")
    install -d -m0755 "$pkgdir/usr/src/apple-t2-bridge-$_module_version"
    cp -a "$dest/." "$pkgdir/usr/src/apple-t2-bridge-$_module_version/"
    sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$_module_version\"/" "$pkgdir/usr/src/apple-t2-bridge-$_module_version/dkms.conf"
    install -D -m0644 "$startdir/modprobe.d/00-kait2en-apple-t2-bridge.conf" "$pkgdir/usr/lib/modprobe.d/00-kait2en-apple-t2-bridge.conf"
    install -D -m0644 "$startdir/mkinitcpio.conf.d/00-kait2en-apple-t2-bridge.conf" "$pkgdir/etc/mkinitcpio.conf.d/00-kait2en-apple-t2-bridge.conf"
    install -D -m0644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
