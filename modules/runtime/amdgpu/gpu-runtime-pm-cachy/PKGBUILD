# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

_kfile=$(pacman -Ql linux-cachyos-headers 2>/dev/null | awk '/\/build\/Makefile$/ {print $2; exit}')
[[ -z $_kfile ]] && _kfile=$(pacman -Fl linux-cachyos-headers 2>/dev/null | awk '/\/build\/Makefile$/ {print $2; exit}')
[[ -n ${_kfile:?linux-cachyos-headers not found (install it, or run 'pacman -Fy' for the sync file list).} ]]
_krelease=$(basename "$(dirname "$(dirname "$_kfile")")")
_upstream=${_krelease%%-*}
[[ $_upstream =~ ^[0-9]+\.[0-9]+\.0$ ]] && _upstream=${_upstream%.0}
_major=${_upstream%%.*}
_kver=$(pacman -Si linux-cachyos-headers 2>/dev/null | awk '/^Version/{print $3; exit}')
_hash=$(curl -fsSL "https://cdn.kernel.org/pub/linux/kernel/v${_upstream%%.*}.x/sha256sums.asc" | awk -v f="linux-${_upstream}.tar.xz" '$2==f {print $1}')
[[ -n ${_kver:?Cannot find linux-cachyos-headers version.} ]]
[[ -n ${_hash:?Cannot find Hashes for kernel ${_kver}.} ]]

pkgname=kait2en-gpu-runtime-pm-cachy
pkgver=7.3.6_1_cachyos.r47.18ad2b0
pkgrel=1
pkgdesc="Patched AMDGPU module with Apple GMUX runtime Power Management. built for cachy kernel (linux-cachyos) - (Supported; MacBook Pro 15,1/16,1/16,4 - iMac20,1/20,2)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
groups=('kait2en-runtime-patches' 'kait2en-amdgpu-patch')
depends=('t2gmux' "linux-cachyos=$_kver")
optdepends=('kernel-modules-hook: Keeps your system fully functional after a kernel upgrade')
makedepends=('git' 'linux-cachyos-headers' 'curl')
provides=('amdgpu-gmux-pm-patch')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git" "https://cdn.kernel.org/pub/linux/kernel/v$_major.x/linux-$_upstream.tar.xz")
sha256sums=('SKIP' "$_hash")

pkgver() {
  local _revision _commit
  _revision=$(git -C "$srcdir/KaiT2en-Fedora" rev-list --count HEAD -- patches/runtime/gpu-runtime-pm)
  _commit=$(git -C "$srcdir/KaiT2en-Fedora" log -1 --format="%h" -- patches/runtime/gpu-runtime-pm)
  printf '%s.r%s.%s' "${_krelease//-/_}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/linux"
    mkdir -p "$srcdir/linux"
    tar -xf "$srcdir/linux-$_upstream.tar.xz" -C "$srcdir/linux" --strip-components=1

    local _fedora="$srcdir/KaiT2en-Fedora/scripts/fedora"
    local _dir="$srcdir/KaiT2en-Fedora/patches/runtime/gpu-runtime-pm"

    source "$_fedora/lib.sh"
    set +eu
    trap - ERR EXIT
    REPO_ROOT="$_dir"
    KVER="$_kver"

    fail() { printf '[kait2en] error: %s\n' "$*" >&2; exit 1; }

    for _p in $(cat "$_dir/series"); do
        [[ "$_p" = \#* || -z "$_p" ]] && continue
        apply_patch_if_needed "$srcdir/linux" "$_dir/$_p" || return 1
    done

    awk '/^rewrite_trace_path\(\) \{/,/^}/' "$_fedora/install-i915.sh" > "$srcdir/.upstream-rtp.sh"
    source "$srcdir/.upstream-rtp.sh"
    rm -f "$srcdir/.upstream-rtp.sh"

    rewrite_trace_path "$srcdir/linux/drivers/gpu/drm/amd/amdgpu/amdgpu_trace.h" ../../drivers/gpu/drm/amd/amdgpu . || return 1
}

build() {
    local _kdir _k
    _kdir=$(pacman -Ql linux-cachyos-headers | awk '/\/build\/Makefile$/ {print $2}' | xargs dirname)
    [[ -n ${_kdir:?linux-cachyos-headers KDIR not found} ]]
    _k=$(basename "$(dirname "$_kdir")")
    make -j"$(nproc)" -C "$_kdir" LLVM=1 LD=ld.lld M="$srcdir/linux/drivers/gpu/drm/amd/amdgpu" modules
    strip --strip-debug "$srcdir/linux/drivers/gpu/drm/amd/amdgpu/amdgpu.ko"
    zstd -T0 -q -f "$srcdir/linux/drivers/gpu/drm/amd/amdgpu/amdgpu.ko" -o "$srcdir/linux/drivers/gpu/drm/amd/amdgpu/amdgpu.ko.zst"
}

package() {
    local _kdir _k
    _kdir=$(pacman -Ql linux-cachyos-headers | awk '/\/build\/Makefile$/ {print $2}' | xargs dirname)
    [[ -n ${_kdir:?linux-cachyos-headers KDIR not found} ]]
    _k=$(basename "$(dirname "$_kdir")")
    install -Dpm 0644 "$srcdir/linux/drivers/gpu/drm/amd/amdgpu/amdgpu.ko.zst" "$pkgdir/usr/lib/modules/$_k/updates/amdgpu.ko.zst"
    install -Dpm 0644 "$startdir/modprobe.d/kait2en-gpu-runtime-pm-cachy.conf" "$pkgdir/usr/lib/modprobe.d/kait2en-gpu-runtime-pm-cachy.conf"
    install -D -m0644 "$startdir/libalpm/70-kait2en-gpu-runtime-pm-cachy.hook" "$pkgdir/usr/share/libalpm/hooks/70-kait2en-gpu-runtime-pm-cachy.hook"
    install -D -m0755 "$startdir/libalpm/kait2en-gpu-runtime-pm-cachy" "$pkgdir/usr/share/libalpm/scripts/kait2en-gpu-runtime-pm-cachy"
    install -Dpm 0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
