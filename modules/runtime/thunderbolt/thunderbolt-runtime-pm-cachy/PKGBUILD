# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

_kfile=$(pacman -Ql linux-cachyos-headers 2>/dev/null | awk '/\/build\/Makefile$/ {print $2; exit}')
[[ -z $_kfile ]] && _kfile=$(pacman -Fl linux-cachyos-headers 2>/dev/null | awk '/\/build\/Makefile$/ {print $2; exit}')
[[ -n ${_kfile:?linux-cachyos-headers not found (install it, or run 'pacman -Fy' for the sync file list).} ]]
_krelease=$(basename "$(dirname "$(dirname "$_kfile")")")
_upstream=${_krelease%%-*}
[[ $_upstream =~ ^[0-9]+\.[0-9]+\.0$ ]] && _upstream=${_upstream%.0}
_major=${_upstream%%.*}
_kver=$(pacman -Si linux-cachyos-headers 2>/dev/null | awk '/^Version/{print $3; exit}')
_hash=$(curl -fsSL "https://cdn.kernel.org/pub/linux/kernel/v${_upstream%%.*}.x/sha256sums.asc" | awk -v f="linux-${_upstream}.tar.xz" '$2==f {print $1}')
[[ -n ${_kver:?Cannot find linux-cachyos-headers version.} ]]
[[ -n ${_hash:?Cannot find Hashes for kernel ${_kver}.} ]]

pkgname=kait2en-thunderbolt-runtime-pm-cachy
pkgver=7.3.6_3_cachyos.r4.4b29a99
pkgrel=1
pkgdesc="Patched thunderbolt module with Titan Ridge & Ice Lake RTD3. built for cachy kernel (linux-cachyos)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
groups=('kait2en-runtime-patches' 'kait2en-thunderbolt-patch')
depends=("linux-cachyos=$_kver")
optdepends=('kernel-modules-hook: Keeps your system fully functional after a kernel upgrade')
makedepends=('git' 'linux-cachyos-headers' 'curl')
provides=('thunderbolt-pm-patch')
conflicts=('t2thunderbolt-dkms')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git" "https://cdn.kernel.org/pub/linux/kernel/v$_major.x/linux-$_upstream.tar.xz")
sha256sums=('SKIP' "$_hash")

pkgver() {
  local _revision _commit
  _revision=$(git -C "$srcdir/KaiT2en-Fedora" rev-list --count HEAD -- patches/runtime/thunderbolt)
  _commit=$(git -C "$srcdir/KaiT2en-Fedora" log -1 --format="%h" -- patches/runtime/thunderbolt)
  printf '%s.r%s.%s' "${_krelease//-/_}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/linux"
    mkdir -p "$srcdir/linux"
    tar -xf "$srcdir/linux-$_upstream.tar.xz" -C "$srcdir/linux" --strip-components=1

    local _fedora="$srcdir/KaiT2en-Fedora/scripts/fedora"
    local _wdir="$srcdir/KaiT2en-Fedora/patches/runtime/thunderbolt"

    source "$_fedora/lib.sh"
    set +u
    trap - ERR EXIT
    REPO_ROOT="$_wdir"
    KVER="$_kver"

    fail() { printf '[kait2en] error: %s\n' "$*" >&2; exit 1; }

    for _patch in $(cat "$_wdir/series"); do
        [[ "$_patch" = \#* || -z "$_patch" ]] && continue
        apply_patch_if_needed "$srcdir/linux" "$_wdir/$_patch" || return 1
    done
}

build() {
    local _kdir _cfg _tb
    _kdir=$(pacman -Ql linux-cachyos-headers | awk '/\/build\/Makefile$/ {print $2}' | xargs dirname)
    [[ -n ${_kdir:?linux-cachyos-headers KDIR not found} ]]
    _cfg="$_kdir/.config"
    _tb="$srcdir/linux/drivers/thunderbolt"

    case $(sed -n 's/^CONFIG_USB4=//p' "$_cfg") in
        m) ;;
        *) fail "the kernel does not build the thunderbolt driver as a module (CONFIG_USB4=m is required)"; return 1 ;;
    esac

    printf '[kait2en] Building thunderbolt\n'
    make -j"$(nproc)" -C "$_kdir" M="$_tb" LLVM=1 LD=ld.lld modules

    strip --strip-debug "$_tb/thunderbolt.ko"
    zstd -T0 -q -f "$_tb/thunderbolt.ko" -o "$_tb/thunderbolt.ko.zst"
}

package() {
    local _kdir _k
    _kdir=$(pacman -Ql linux-cachyos-headers | awk '/\/build\/Makefile$/ {print $2}' | xargs dirname)
    [[ -n ${_kdir:?linux-cachyos-headers KDIR not found} ]]
    _k=$(basename "$(dirname "$_kdir")")
    install -Dpm 0644 "$srcdir/linux/drivers/thunderbolt/thunderbolt.ko.zst" "$pkgdir/usr/lib/modules/$_k/updates/thunderbolt.ko.zst"
    install -D -m0644 "$startdir/libalpm/70-kait2en-thunderbolt-runtime-pm-cachy.hook" "$pkgdir/usr/share/libalpm/hooks/70-kait2en-thunderbolt-runtime-pm-cachy.hook"
    install -D -m0755 "$startdir/libalpm/kait2en-thunderbolt-runtime-pm-cachy" "$pkgdir/usr/share/libalpm/scripts/kait2en-thunderbolt-runtime-pm-cachy"
    install -Dpm 0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
