# Maintainer: André Eikmeyer (deqrocks) <dev@deq.rocks>
# Packager: Turann_ (turannul) <turanull000@gmail.com>

_kfile=$(pacman -Ql linux-headers 2>/dev/null | awk '/\/build\/Makefile$/ {print $2; exit}')
[[ -z $_kfile ]] && _kfile=$(pacman -Fl linux-headers 2>/dev/null | awk '/\/build\/Makefile$/ {print $2; exit}')
[[ -n ${_kfile:?linux-headers not found (install it, or run 'pacman -Fy' for the sync file list).} ]]
_krelease=$(basename "$(dirname "$(dirname "$_kfile")")")
_upstream=${_krelease%%-arch*}
_major=${_upstream%%.*}
_kver=$(pacman -Si linux-headers 2>/dev/null | awk '/^Version/{print $3; exit}')
[[ -n ${_kver:?Cannot find linux-headers version.} ]]

pkgname=kait2en-wireless-runtime-pm
pkgver=0
pkgrel=1
pkgdesc="Patched Broadcom wireless modules with Apple coexistence fixes"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=("linux$_kver")
makedepends=('git' 'linux-headers')
provides=('kait2en-wireless-runtime-pm')
conflicts=('kait2en-wireless-runtime-pm-t2')
replaces=('kait2en-wireless-runtime-pm-t2')
source=("git+https://github.com/kaiT2en/KaiT2en-Fedora.git")
noextract=("linux-$_upstream.tar.xz")
sha256sums=('SKIP')

pkgver() {
  local _revision _commit
  _revision=$(git -C "$srcdir/KaiT2en-Fedora" rev-list --count HEAD -- patches/runtime/wireless)
  _commit=$(git -C "$srcdir/KaiT2en-Fedora" log -1 --format="%h" -- patches/runtime/wireless)
  printf '%s.r%s.%s' "${_krelease//-/_}" "${_revision:?}" "${_commit:?}"
}

prepare() {
    rm -rf "$srcdir/linux"
    mkdir -p "$srcdir/linux"
    tar -xf "$srcdir/linux-$_upstream.tar.xz" -C "$srcdir/linux" --strip-components=1
    local _wdir="$srcdir/KaiT2en-Fedora/patches/runtime/wireless"
    local _patch
    for _patch in $(cat "$_wdir/series"); do
        [[ "$_patch" = \#* || -z "$_patch" ]] && continue
        local _patch_path="$_wdir/$_patch"
        if patch -d "$srcdir/linux" -p1 --dry-run --batch --forward --fuzz=3 \
                --no-backup-if-mismatch <"$_patch_path" >/dev/null 2>&1; then
            info "applying wireless patch $_patch"
            patch -d "$srcdir/linux" -p1 --batch --forward --fuzz=3 \
                --no-backup-if-mismatch <"$_patch_path"
        elif patch -d "$srcdir/linux" -p1 --dry-run --batch --reverse --fuzz=3 \
                --no-backup-if-mismatch <"$_patch_path" >/dev/null 2>&1; then
            info "skipping $_patch (already present in kernel $_upstream)"
        else
            echo "==> WARNING: wireless patch $_patch may not apply to kernel $_upstream"
        fi
    done
}

build() {
    local _kdir _k
    _kdir=$(pacman -Ql linux-headers | awk '/\/build\/Makefile$/ {print $2}' | xargs dirname)
    [[ -n ${_kdir:?linux-headers KDIR not found} ]]
    _k=$(basename "$(dirname "$_kdir")")
    if [[ -d "$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac" ]]; then
        info "building brcmfmac wireless modules"
        make -j"$(nproc)" -C "$_kdir" M="$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac" modules
        strip --strip-debug "$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko"
        zstd -T0 -q -f "$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko" -o "$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko.zst"
    fi
    if [[ -d "$srcdir/linux/drivers/bluetooth/btbcm" ]]; then
        info "building btbcm Bluetooth modules"
        make -j"$(nproc)" -C "$_kdir" M="$srcdir/linux/drivers/bluetooth/btbcm" modules
        strip --strip-debug "$srcdir/linux/drivers/bluetooth/btbcm/btbcm.ko"
        zstd -T0 -q -f "$srcdir/linux/drivers/bluetooth/btbcm/btbcm.ko" -o "$srcdir/linux/drivers/bluetooth/btbcm/btbcm.ko.zst"
    fi
}

package() {
    local _kdir _k
    _kdir=$(pacman -Ql linux-headers | awk '/\/build\/Makefile$/ {print $2}' | xargs dirname)
    [[ -n ${_kdir:?linux-headers KDIR not found} ]]
    _k=$(basename "$(dirname "$_kdir")")
    if [[ -f "$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko.zst" ]]; then
        install -Dpm 0644 "$srcdir/linux/drivers/net/wireless/broadcom/brcm80211/brcmfmac/brcmfmac.ko.zst" "$pkgdir/usr/lib/modules/$_k/updates/brcmfmac.ko.zst"
    fi
    if [[ -f "$srcdir/linux/drivers/bluetooth/btbcm/btbcm.ko.zst" ]]; then
        install -Dpm 0644 "$srcdir/linux/drivers/bluetooth/btbcm/btbcm.ko.zst" "$pkgdir/usr/lib/modules/$_k/updates/btbcm.ko.zst"
    fi
    install -Dpm 0644 /dev/null "$pkgdir/usr/lib/modprobe.d/$pkgname.conf" || true
    if [[ -d "$srcdir/KaiT2en-Fedora" && -f "$srcdir/KaiT2en-Fedora/LICENSE" ]]; then
        install -Dpm 0644 "$srcdir/KaiT2en-Fedora/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}