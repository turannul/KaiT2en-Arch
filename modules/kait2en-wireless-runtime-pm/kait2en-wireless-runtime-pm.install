_check_kernel() {
    local _kernel_release=$(uname -r)

    case $_kernel_release in
        *-arch*-*) ;;
        *) echo "==> [kait2en] WARNING: This package is for stock Arch (linux)."
           echo "==> [kait2en] Running kernel: ${_kernel_release}"
           echo "==> [kait2en] Install the correct variant for your kernel." ;;
    esac
}

_reload() {
    local kver=$(uname -r) m mods=()

    for m in brcmfmac hci_uart hci_bcm4377; do
        [[ -d /sys/module/$m ]] && mods+=("$m")
    done
    ((${#mods[@]})) || return 0

    echo "==> [kait2en] reloading ${mods[*]}: expect a brief disconnect"
    modprobe -r "${mods[@]}" || true
    depmod -a "$kver"
    for m in "${mods[@]}"; do
        modprobe "$m" || echo "==> [kait2en] modprobe $m failed; reboot to load the module"
    done
    if [[ " ${mods[*]} " == *" hci_uart "* ]]; then
        echo "==> [kait2en] hci_uart reloaded; if Bluetooth stays down, restart its attach service or reboot"
    fi
}

post_install() { _check_kernel; _reload; }
post_upgrade() { _check_kernel; _reload; }
post_remove()  { _reload; }